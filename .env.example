# Copy to .env using install.sh. All secrets below must be generated.
PANEL_DOMAIN=deploy.example.com
PUBLIC_URL=https://deploy.example.com
ACME_EMAIL=admin@example.com
SERVER_IP=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
ENCRYPTION_KEY=
SETUP_TOKEN=
AGENT_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
# Absolute server path; create an empty file if integration is unused.
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
